{
  "manifest_version": 3,
  "name": "Save & Transcribe",
  "version": "0.2.0",
  "description": "One click sends the current page (video, podcast or post) to Media Intelligence.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://127.0.0.1:8875/*",
    "http://localhost/*",
    "http://localhost:8875/*",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "*://*.bilibili.com/*",
    "*://bilibili.com/*",
    "*://b23.tv/*",
    "*://*.xiaohongshu.com/*",
    "*://xiaohongshu.com/*",
    "*://*.rednote.com/*",
    "*://rednote.com/*",
    "*://xhslink.com/*",
    "*://*.xhslink.com/*",
    "*://*.threads.com/*",
    "*://threads.com/*",
    "*://*.threads.net/*",
    "*://threads.net/*",
    "*://*.linkedin.com/*",
    "*://linkedin.com/*",
    "*://lnkd.in/*",
    "*://*.xiaoyuzhoufm.com/*",
    "*://xiaoyuzhoufm.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save & Transcribe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.bilibili.com/*",
        "*://bilibili.com/*",
        "*://www.xiaohongshu.com/*",
        "*://xiaohongshu.com/*",
        "*://*.xiaohongshu.com/*",
        "*://www.rednote.com/*",
        "*://rednote.com/*",
        "*://*.rednote.com/*",
        "*://xhslink.com/*",
        "*://*.xhslink.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js"
      ],
      "matches": [
        "*://*.xiaohongshu.com/*",
        "*://xiaohongshu.com/*",
        "*://*.rednote.com/*",
        "*://rednote.com/*"
      ]
    }
  ]
}
