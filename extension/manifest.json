{
  "manifest_version": 3,
  "name": "Save & Transcribe",
  "version": "0.1.5",
  "description": "Save Bilibili and YouTube videos to Obsidian with local speech recognition.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "*://*.youtube.com/*",
    "*://youtube.com/*",
    "*://youtu.be/*",
    "*://*.bilibili.com/*",
    "*://bilibili.com/*",
    "*://b23.tv/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save & Transcribe",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*",
        "*://www.bilibili.com/*",
        "*://bilibili.com/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
